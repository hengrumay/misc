# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Vite
node_modules/
dist/
.vite/
*.local

# Databricks
.databricks/
.databricks-login.json
bundle.tf.json

# Env / secrets (never commit)
.env
.env.*
*.pem
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Build artifacts
app/backend/static/
build/

# NOTE: app/static/ (built Vite bundle) and app/lib/ + app/demo.config.yaml
# (vendored by app/build.py) are intentionally TRACKED so `databricks bundle`
# syncs them to the app (bundle sync honors .gitignore; ignoring them 404s the SPA).
# The tracked demo.config.example.yaml is the placeholder single source of truth;
# app/ copies are build artifacts regenerated by app/build.py from the root config.

# Local real deploy values — never commit (copy demo.config.example.yaml -> demo.config.yaml)
/demo.config.yaml

# npm proxy config (internal); regenerate per environment
app/frontend/.npmrc

# tsc stray emit (source is .tsx/.ts; app runtime uses app/static bundle)
app/frontend/src/**/*.js
app/frontend/**/*.tsbuildinfo
app/frontend/vite.config.js
app/frontend/vite.config.d.ts
